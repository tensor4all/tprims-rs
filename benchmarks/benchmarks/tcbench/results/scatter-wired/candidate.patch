+#[inline]
+fn step(counter: &mut [i64], extents: &[i64], strides: &[i64], mut offset: i64, n: usize) -> i64 {
+    for d in 0..n {
+        counter[d] += 1;
+        offset += strides[d];
+        if counter[d] < extents[d] {
+            break;
+        }
+        offset -= strides[d] * extents[d];
+        counter[d] = 0;
+    }
+    offset
